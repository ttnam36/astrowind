---
import Layout from '~/layouts/PageLayout.astro';

import Button from '~/components/ui/Button.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'MenuWise — Straightforward menu costing, nutrition tracking, and compliance checks',
  description:
    'MenuWise helps professional kitchens calculate real food costs, nutrition information, and compliance details using their actual suppliers, recipes, and day-to-day assumptions.',
  ignoreTitleTemplate: true,
};

// Where the "Sign up for free" buttons point. Replace with the real sign-up URL.
const signUpUrl = '/contact';

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Widget ******************* -->

  <Hero>
    <Fragment slot="title">
      Reliable numbers for <span class="text-accent dark:text-white">real menu decisions</span>
    </Fragment>

    <Fragment slot="subtitle">
      MenuWise gives professional kitchens clear, traceable costs, nutrition breakdowns, and compliance checks — based
      on the suppliers and recipes they actually use.
      <span class="block mt-6 text-lg">
        It works with recipes as they are.<br />
        You don’t need to change how food is prepped, portioned, or priced.<br />
        <span class="font-semibold text-default dark:text-white">Every number can be traced back to its source.</span>
      </span>
    </Fragment>

    <Fragment slot="content">
      <div class="flex flex-col sm:flex-row sm:justify-center gap-4 max-w-xs sm:max-w-none mx-auto">
        <Button variant="primary" text="Sign up for free" href={signUpUrl} class="whitespace-nowrap" />
        <Button text="How the numbers are produced" href="#how-it-works" class="whitespace-nowrap" />
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div
        class="absolute inset-0 bg-[radial-gradient(60%_55%_at_15%_20%,rgb(129_140_248/0.18),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(1_97_239/0.14),transparent_65%)] dark:bg-[radial-gradient(60%_55%_at_15%_20%,rgb(99_102_241/0.2),transparent_65%),radial-gradient(50%_50%_at_85%_25%,rgb(1_97_239/0.16),transparent_65%)]"
      >
      </div>
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="kitchens"
    title="Designed for how kitchens actually operate"
    subtitle="Kitchens move fast. Decisions are made with whatever information is available at the time."
  >
    <Fragment slot="content">
      <p class="mb-6">
        Supplier prices change without warning. Pack sizes shift. Specs get updated. Allergen and nutrition rules
        tighten. Small gaps don’t always show up immediately — they surface later as blown margins, audit issues, or
        uncomfortable questions from finance or compliance teams.
      </p>
      <p>
        Most kitchens already have ordering systems and accounting software. What’s usually missing is a way to trust
        the numbers when pricing a dish, updating a menu, or rolling changes across locations.
      </p>
    </Fragment>

    <Fragment slot="image">
      <div
        class="flex flex-col justify-center gap-6 rounded-lg bg-primary p-10 md:p-12 text-white shadow-lg aspect-[4/3]"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="w-12 h-12"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M9 12l2 2l4 -4"></path><path
            d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"></path></svg
        >
        <p class="text-3xl md:text-4xl font-bold tracking-tighter font-heading">MenuWise exists to close that gap.</p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    id="what-it-is"
    isReversed
    title="What MenuWise is (and isn’t) for"
    items={[
      { title: 'What they actually cost based on current supplier data', icon: 'tabler:receipt' },
      { title: 'What the nutrition and allergen profile looks like', icon: 'tabler:salad' },
      { title: 'Where compliance issues might appear', icon: 'tabler:shield-check' },
    ]}
  >
    <Fragment slot="content">
      <p class="mb-6">MenuWise doesn’t run service, manage staff, or tell teams how to cook.</p>
      <p>It takes the recipes already in use and shows:</p>
    </Fragment>

    <Fragment slot="image">
      <div
        class="flex flex-col justify-center gap-6 rounded-lg bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 p-10 md:p-12 shadow-lg"
      >
        <p class="text-lg text-muted dark:text-slate-400">
          That gives teams the chance to adjust early — before problems spread across a menu or a group.
        </p>
        <p class="text-2xl md:text-3xl font-bold tracking-tighter font-heading text-heading">
          You stay in control of food decisions. <span class="text-primary">MenuWise backs them up with data.</span>
        </p>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features Widget *************** -->

  <Features
    id="avoid"
    title="What MenuWise helps teams avoid"
    subtitle="Chefs and operators already understand food cost and waste. The harder part is spotting issues early enough to act.<span class='block mt-6 font-semibold text-default dark:text-white'>MenuWise helps teams:</span>"
    items={[
      { title: 'Catch high-cost items or compliance slips early', icon: 'tabler:alert-triangle' },
      {
        title: 'See exactly why a number changed (for example, a supplier price increase or pack change)',
        icon: 'tabler:zoom-question',
      },
      { title: 'Fix small issues before they affect multiple dishes or sites', icon: 'tabler:tool' },
      { title: 'Keep control of supplier-driven data without extra admin', icon: 'tabler:truck-delivery' },
    ]}
  />

  <!-- Note Widget ******************* -->

  <Note
    icon="tabler:bulb"
    description="It doesn’t override judgement or lock recipes into rigid templates. It simply gives clearer information sooner, so decisions hold up in practice."
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="how-it-works"
    title="How the numbers are produced"
    subtitle="Every figure in MenuWise is broken down so teams can see what went into it:"
    items={[
      { title: 'Costs from supplier pack sizes and prices', icon: 'tabler:package' },
      { title: 'Nutrition and allergen data from verified sources', icon: 'tabler:certificate' },
      { title: 'Yields, substitutions, and preparation changes clearly shown', icon: 'tabler:arrows-exchange' },
      { title: 'Any updates flagged, with the cause identified', icon: 'tabler:flag' },
    ]}
    callToAction='<p class="mt-8 text-xl text-muted dark:text-slate-400">This transparency cuts down on surprises and makes conversations with finance teams, auditors, or regulators easier.</p>'
  />

  <!-- Features3 Widget ************** -->

  <Features3
    id="integrations"
    title="Built to fit into existing kitchen systems"
    columns={3}
    items={[
      {
        description:
          'MenuWise works alongside the tools kitchens already use. There’s no need to replace POS systems, ordering platforms, or suppliers.',
        icon: 'tabler:plug-connected',
      },
      {
        description:
          'Recipes don’t need to be rewritten to suit the software, and ingredients don’t need to be grouped in ways that don’t match how kitchens work.',
        icon: 'tabler:notebook',
      },
      {
        description:
          'There is some upfront setup — good numbers always require effort. But once data is in, it stays easy to update, track, and review instead of getting buried or outdated.',
        icon: 'tabler:refresh',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features3>

  <!-- Features2 Widget ************** -->

  <Features2
    id="start"
    title="Start where it makes sense"
    subtitle="Most teams test new tools on a small scale first. MenuWise supports that:"
    columns={4}
    items={[
      { title: 'Free personal accounts for testing recipes', icon: 'tabler:user' },
      { title: 'Pricing per site, not per user', icon: 'tabler:building-store' },
      { title: 'Free access for approved education and training organisations', icon: 'tabler:school' },
      {
        title: 'Enterprise options for large operations needing audits, SSO, or governance controls',
        icon: 'tabler:building-skyscraper',
      },
    ]}
  />

  <!-- Note Widget ******************* -->

  <Note
    variant="success"
    icon="tabler:trending-up"
    title="Teams start small and scale only if it proves useful."
    description="MenuWise is used by independent venues watching every dollar, multi-site groups focused on consistency, and healthcare or institutional kitchens working under strict regulations."
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    id="try-it"
    layout="banner"
    title="Try it with your own data"
    actions={[{ variant: 'primary', text: 'Sign up for free', href: signUpUrl, icon: 'tabler:chef-hat' }]}
  >
    <Fragment slot="subtitle">
      MenuWise was built from real kitchen work — reviewing menus, checking invoices, and dealing with compliance
      requirements, not demo-only workflows.
      <span class="block mt-4">
        Sign up for free. Add a recipe, a supplier price, and see the costing, nutrition, and compliance checks update
        immediately.
      </span>
    </Fragment>
  </CallToAction>
</Layout>
